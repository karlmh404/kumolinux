#!/usr/bin/env python3
"""Build deterministic local or publishable Kumo repositories from .kpkg files."""
from __future__ import annotations

import argparse
import hashlib
import io
import json
import re
import shutil
import subprocess
import tarfile
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
PACKAGES = ROOT / "out" / "packages"
SOURCE_DATE_EPOCH = 1762128000
ZSTD = shutil.which("zstd") or str(ROOT / "work" / "host-tools" / "zstd" / "programs" / "zstd")


def fail(message: str) -> None:
    raise SystemExit(f"[kumo-repo] ERROR: {message}")


def quote(value: str) -> str:
    return json.dumps(value, ensure_ascii=True)


def file_hash(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)
    build = sub.add_parser("build", help="build a local repository index")
    build.add_argument("--channel", choices=("stable", "testing"))
    build.add_argument("--arch", default="x86_64")
    build.add_argument("destination", type=Path)
    args = parser.parse_args()

    if not re.fullmatch(r"[a-z0-9_]+", args.arch):
        fail(f"invalid architecture name: {args.arch}")
    destination = args.destination.resolve()
    if args.channel:
        destination = destination / args.channel / args.arch
    archives = sorted(PACKAGES.glob("*.kpkg"))
    if not archives:
        fail(f"no canonical packages found under {PACKAGES}")

    records = []
    seen = set()
    destination_packages = destination / "packages"
    if destination_packages.exists():
        shutil.rmtree(destination_packages)
    destination_packages.mkdir(parents=True, exist_ok=True)
    for archive in archives:
        digest = file_hash(archive)
        try:
            output = subprocess.check_output([ZSTD, "-q", "-d", "-c", str(archive)])
            with tarfile.open(fileobj=io.BytesIO(output), mode="r:") as package_tar:
                member = package_tar.extractfile("metadata.toml")
                if member is None:
                    fail(f"{archive.name}: metadata.toml is missing")
                metadata = tomllib.loads(member.read().decode("utf-8", "strict"))
        except (subprocess.CalledProcessError, UnicodeDecodeError, tomllib.TOMLDecodeError) as error:
            fail(f"cannot read {archive.name}: {error}")
        if metadata.get("kpkg_version") != 1:
            fail(f"{archive.name}: unsupported kpkg format")
        package = metadata.get("package", {})
        name, version, release = package.get("name"), package.get("version"), package.get("release")
        if not name or not version or not isinstance(release, int):
            fail(f"{archive.name}: incomplete package metadata")
        if package.get("architecture") != args.arch:
            fail(f"{archive.name}: architecture does not match {args.arch}")
        key = (name, version, release)
        if key in seen:
            fail(f"duplicate package version in repository: {name} {version}-{release}")
        seen.add(key)
        expected_name = f"{name}-{version}-{release}-x86_64.kpkg"
        if archive.name != expected_name:
            fail(f"{archive.name}: expected canonical filename {expected_name}")
        shutil.copy2(archive, destination_packages / archive.name)
        records.append({
            "name": name,
            "version": version,
            "release": release,
            "architecture": package["architecture"],
            "description": package.get("description", ""),
            "runtime_dependencies": metadata.get("dependencies", {}).get("runtime", []),
            "filename": archive.name,
            "size": archive.stat().st_size,
            "sha256": digest,
        })

    records.sort(key=lambda item: (item["name"], item["version"], item["release"]))
    (destination / "repo.toml").write_text(
        "repository_format = 1\n\n"
        "[repository]\n"
        f'name = {quote("Kumo " + args.channel.title() if args.channel else "Kumo Local")}\n'
        f'channel = {quote(args.channel or "stable")}\n'
        f'architecture = {quote(args.arch)}\n'
        f"source_date_epoch = {SOURCE_DATE_EPOCH}\n"
        f"package_count = {len(records)}\n",
        encoding="utf-8",
    )
    index = [
        'format_version = 1',
        f'architecture = {quote(args.arch)}',
        f"source_date_epoch = {SOURCE_DATE_EPOCH}",
        f"package_count = {len(records)}",
        "",
    ]
    for record in records:
        index.extend((
            "[[package]]",
            f"name = {quote(record['name'])}",
            f"version = {quote(record['version'])}",
            f"release = {record['release']}",
            f"architecture = {quote(record['architecture'])}",
            f"description = {quote(record['description'])}",
            f"runtime_dependencies = {json.dumps(record['runtime_dependencies'])}",
            f"filename = {quote(record['filename'])}",
            f"size = {record['size']}",
            f"sha256 = {quote(record['sha256'])}",
            "",
        ))
    (destination / "index.toml").write_text("\n".join(index), encoding="utf-8")
    print(f"[kumo-repo] indexed {len(records)} packages in {destination}")


if __name__ == "__main__":
    main()
