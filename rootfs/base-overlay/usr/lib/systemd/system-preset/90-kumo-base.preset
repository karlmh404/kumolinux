disable *
enable systemd-journald.service
enable systemd-udevd.service
enable systemd-udev-trigger.service
enable systemd-tmpfiles-setup.service
enable systemd-sysusers.service
enable systemd-logind.service
enable getty@tty1.service
enable seatd.service
enable serial-getty@ttyS0.service
disable dev-hugepages.mount
disable dev-mqueue.mount
disable sys-kernel-debug.mount
disable sys-kernel-tracing.mount
disable systemd-vconsole-setup.service
