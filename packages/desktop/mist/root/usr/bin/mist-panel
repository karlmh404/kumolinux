#!/usr/bin/env bash
# mist-panel - Simple Mist desktop panel
# Shows workspace, clock, and system info in a small overlay window

set -euo pipefail

PANEL_HEIGHT=30
PANEL_COLOR="#1e293b"
TEXT_COLOR="#f8fafc"

# Get screen dimensions
read -r SCREEN_W SCREEN_H < <(hyprctl monitors -j 2>/dev/null | jq -r '.[0].resolution | split("x") | .[0], .[1]' 2>/dev/null || echo "1920 1080")

# Position panel at top-left
PANEL_W=400
PANEL_X=20
PANEL_Y=20

# Create a simple panel using weston-terminal in a small window
# This is a lightweight placeholder until a proper Quickshell panel is built
exec weston-terminal \
    --geometry=${PANEL_W}x${PANEL_HEIGHT}+${PANEL_X}+${PANEL_Y} \
    --title="mist-panel" \
    --working-directory="$HOME" \
    -e 'bash -c "
        while true; do
            clear
            echo \"\033[1;36m\u2601 Mist\033[0m\"
            echo \"\"
            echo \"\033[1mWorkspaces:\033[0m\"
            hyprctl activeworkspace -j 2>/dev/null | jq -r \"[.id, .name] | join(\": \")\" 2>/dev/null || echo \"1: main\"
            echo \"\"
            echo \"\033[1mTime:\033[0m $(date \"+%H:%M:%S\")\"
            echo \"\033[1mDate:\033[0m $(date \"+%Y-%m-%d\")\"
            echo \"\"
            echo \"\033[1mKeys:\033[0m\"
            echo \"  Super+Q  Terminal\"
            echo \"  Super+Space  Launcher\"
            echo \"  Super+C  Close\"
            echo \"  Super+F  Fullscreen\"
            echo \"  Super+V  Floating\"
            echo \"  Super+M  Exit\"
            echo \"  Super+L  Lock\"
            sleep 2
        done
    "'
