# Kumo general-purpose x86_64 hardware baseline.
# Boot-critical root, virtio, ext4, PCI, and serial options remain built in.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_FW_LOADER=y
CONFIG_PCI=y
CONFIG_PCIEPORTBUS=y
CONFIG_ACPI=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_THERMAL=y
CONFIG_ACPI_VIDEO=y
CONFIG_POWER_SUPPLY=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_STORAGE=m
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_INPUT_EVDEV=y
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=y
CONFIG_NVME_CORE=m
CONFIG_BLK_DEV_NVME=m
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=m
CONFIG_SPI=y
CONFIG_GPIOLIB=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y
CONFIG_HWMON=y
CONFIG_THERMAL=y
CONFIG_CPU_FREQ=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_AMD_PSTATE=y
CONFIG_X86_ACPI_CPU_FREQ=y
CONFIG_CPU_IDLE=y
CONFIG_IGB=m
CONFIG_IGC=m
CONFIG_R8169=m
CONFIG_EXFAT_FS=m
CONFIG_UDF_FS=m
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_USB_AUDIO=m
