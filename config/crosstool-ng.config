CT_CONFIG_VERSION="4"
CT_ARCH_X86=y
CT_ARCH_64=y
CT_TARGET_VENDOR="kumo"
CT_KERNEL_LINUX=y
CT_LINUX_V_6_18=y
CT_BINUTILS_V_2_47=y
CT_GLIBC_V_2_44=y
CT_CC_GCC_V_16_2_0=y
CT_THREADS_POSIX=y
CT_CC_LANG_CXX=y
CT_PREFIX_DIR="${CT_TOP_DIR}/../../out/toolchain"
CT_LOG_PROGRESS_BAR=n
CT_LOCAL_TARBALLS_DIR="${CT_TOP_DIR}/../../cache/distfiles"
CT_SAVE_TARBALLS=y

